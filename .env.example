# Cloud Function that receives the form submission. Deploy via
# `firebase deploy --only functions:submitAssociate` and paste the
# printed HTTPS URL here. Leaving it empty makes the form log the
# payload to the console instead of hitting the backend — useful for
# local UI work before the backend is deployed.
VITE_SUBMIT_URL=

# Cloud Function that serves the analytics view. Same drill as above —
# paste the URL printed by `firebase deploy --only functions:listAssociates`.
# The admin key that gates access is set separately as a Functions secret:
#   firebase functions:secrets:set ADMIN_KEY
VITE_ADMIN_URL=
