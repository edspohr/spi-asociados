{
  "name": "spi-asociados-functions",
  "private": true,
  "version": "0.0.1",
  "description": "Cloud Functions backend for SPI Asociados: submit + list.",
  "main": "lib/index.js",
  "engines": { "node": "22" },
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "serve": "npm run build && firebase emulators:start --only functions",
    "shell": "npm run build && firebase functions:shell",
    "logs": "firebase functions:log"
  },
  "dependencies": {
    "@firebase/app": "^0.16.0",
    "firebase-admin": "^14.2.0",
    "firebase-functions": "^7.3.2"
  },
  "devDependencies": {
    "typescript": "~5.9.2"
  }
}
